# reads fixed folders). Untrack once with:
#   git rm -r --cached "src/Z - Archived code" src/commands/_archive_pvp
src/Z - Archived code/
src/commands/_archive_pvp/

# automated tests (npm test / test:db / test:net): kept local, not shipped
test/

# dev/admin scripts: run by hand from this PC, never loaded by the bot.
# Untrack the already-committed ones once with:  git rm -r --cached scripts
scripts/
